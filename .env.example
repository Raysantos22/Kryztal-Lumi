# =====================================================================
# Kryztal Lumi — environment variables. Copy to `.env.local` (frontend +
# scripts) and set the edge-function secrets with `supabase secrets set`.
# Never commit real values.
# =====================================================================

# ---- Frontend (Vite; safe to expose — the anon key is protected by RLS) ----
# Leave VITE_SUPABASE_URL empty to run the shop in DEMO mode (in-browser DB).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public site address, used for social-share images and product structured data
VITE_SITE_URL=https://your-domain.com
# Force demo mode even when a Supabase URL is set (true/false)
VITE_DEMO_MODE=false

# ---- Scripts only (scripts/create-admin.mjs) ----
# SERVER-SIDE SECRET: never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# ---- Edge function secrets (supabase secrets set KEY=value) -----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to edge functions automatically by Supabase.
SITE_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com
# Channels to use: "email" (default). Add ",sms" to switch on Twilio.
NOTIFY_CHANNELS=email
# Resend (email) — https://resend.com (verify your domain there first)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Kryztal Lumi <orders@your-domain.com>
RESEND_REPLY_TO=
# Fallback for new-order alerts if no alert email is set in Admin → Settings
OWNER_NOTIFY_EMAIL=
# Twilio SMS (stub, OFF unless NOTIFY_CHANNELS includes sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_COUNTRY_CODE=63
OWNER_NOTIFY_PHONE=
# Shared secret the DB trigger sends to send-order-update (same value as the
# Vault secret notify_webhook_secret — see README §4)
NOTIFY_WEBHOOK_SECRET=
# Only needed if you schedule expire-unpaid-orders externally
CRON_SECRET=
